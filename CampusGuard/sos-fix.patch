+.student { max-width:560px; margin:0 auto; text-align:center; }.sosButton { width:min(84vw,420px); aspect-ratio:1; border-radius:50%; font-size:clamp(3rem,14vw,7rem); letter-spacing:-.1em; box-shadow:0 10px 0 #8f2118; }.sosButton { touch-action:manipulation; -webkit-tap-highlight-color:transparent; transition:transform 100ms ease-out, box-shadow 100ms ease-out; }.sosButton:active { transform:translateY(6px); box-shadow:0 4px 0 #8f2118; }.sosHint { font:12px var(--font-data); color:var(--ink-soft); margin:26px 0 32px; }.reportButton { width:100%; padding:16px; }.report { text-align:left; border-top:1px solid var(--rule); margin-top:32px; padding-top:28px; }.confirmation { padding:32px 0; }.confirmationMark { color:var(--low); border:2px solid var(--low); width:52px; height:52px; display:grid; place-items:center; border-radius:50%; font-size:28px; margin-bottom:20px; }.confirmation h2 { margin-bottom:12px; }.confirmation p { color:var(--ink-soft); line-height:1.45; }.emergencyLine { color:var(--ink)!important; font-weight:700; }.triage { border-top:1px solid var(--rule); border-bottom:1px solid var(--rule); padding:16px 0; margin:28px 0; text-align:left; }.notice { border:1px solid var(--low); padding:14px; margin:16px 0; text-align:left; }.confirmationActions { display:flex; align-items:center; gap:16px; flex-wrap:wrap; margin-top:20px; }.confirmationActions .button { margin-top:0; }.cancelLink { margin:0; }
+@media(max-width:600px) { .student { max-width:100%; }.sosButton { width:min(58vw,220px); font-size:clamp(2.4rem,13vw,4rem); box-shadow:0 7px 0 #8f2118; }.sosHint { margin:22px 0 28px; font-size:11px; }.reportButton { padding:14px 12px; }.confirmation { padding:24px 0; }.confirmationActions { align-items:stretch; flex-direction:column; gap:10px; }.confirmationActions .button,.confirmationActions .cancelLink { width:100%; text-align:center; }.confirmationActions .cancelLink { padding:8px 0; }.confirmation h2 { font-size:1.55rem; } }
+
+.cancelWrap { display:grid; gap:6px; min-width:200px; }
+.cancelTimer { display:block; height:3px; background:var(--emergency); transform-origin:left center; animation:cancelDrain 10s linear forwards; }
+@keyframes cancelDrain { from { transform:scaleX(1); } to { transform:scaleX(0); } }
+@media (prefers-reduced-motion: reduce) { .sosButton { transition:none; } }
